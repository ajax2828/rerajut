# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi server Anda.
# Jangan pernah mengunggah file .env ke repository publik.

# Mode debug (false di server produksi, true hanya saat debugging)
APP_DEBUG=false

# Opsional: kosongkan agar BASE_URL & SITE_URL terdeteksi otomatis.
# Isi APP_BASE_URL=/ untuk memaksa root domain, atau /triftweb untuk subfolder.
APP_BASE_URL=
APP_URL=

# Konfigurasi Database MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rerajut_thrift
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# Opsional: path unix socket jika MySQL memakai socket khusus
DB_SOCKET=

# Zona waktu aplikasi & database
APP_TIMEZONE=Asia/Jakarta
DB_TIMEZONE=+07:00

# Pengaturan Toko & Pembayaran
SITE_NAMA="Rerajut Thrift"
SITE_EMAIL="halo@rerajut.id"
SITE_TELEPON="0812-3456-7890"
SITE_ALAMAT="Jl. Melati No. 21, Yogyakarta"
ONGKIR=15000
GRATIS_ONGKIR_MIN=250000

BANK_NAMA="BCA"
BANK_REKENING="1234567890"
BANK_ATAS_NAMA="Rerajut Thrift"
EWALLET_NAMA="GoPay, OVO, DANA"
EWALLET_NOMOR="0812-3456-7890"
EWALLET_ATAS_NAMA="Rerajut Thrift"
